{
  "name": "rift-exchange",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "check": "tsc --noEmit && eslint src --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check src tests *.json *.md",
    "smoke": "node scripts/smoke-build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  }
}
